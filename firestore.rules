rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // TasteMatch Recipe Reviews & Comments
    // Public read for all users and visitors across all devices.
    // Only authenticated author can delete their own review.
    // =========================================================================
    match /recipe_comments/{commentId} {
      // Any visitor on any device can read comments
      allow read: if true;

      // Authenticated users and guests can create reviews
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && (request.auth != null ? request.resource.data.userId == request.auth.uid : true);

      // Only allow updating like count/reactions, or full edit by original author
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']))
                    || (request.auth != null && resource.data.userId == request.auth.uid);

      // Strict author-only deletion: only the user who created the review can delete it
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // =========================================================================
    // TasteMatch Community Custom Recipes
    // Public read for all users across devices.
    // Authenticated users can create, and only authors can edit or delete.
    // =========================================================================
    match /custom_recipes/{recipeId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string;

      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }

    // =========================================================================
    // User Profiles & Saved Preferences
    // Only the owner can write their private user document.
    // =========================================================================
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /saved_recipes/{recipeDoc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
